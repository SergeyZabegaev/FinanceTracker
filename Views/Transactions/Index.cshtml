@model FinanceTracker.ViewModels.TransactionsIndexViewModel
@{
    ViewData["Title"] = "Учет финансов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Мои финансы</h2>
        <div>
            <a asp-action="ExportCsv"
               asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
               asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
               asp-route-typeFilter="@Model.TypeFilter"
               class="btn btn-outline-success">📥 Экспорт в CSV</a>
            <a asp-action="Create" class="btn btn-primary">+ Добавить операцию</a>
        </div>
    </div>

    <!-- Карточки с итогами -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Доходы за период</h5>
                    <h3>@Model.TotalIncome.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-danger mb-3">
                <div class="card-body">
                    <h5 class="card-title">Расходы за период</h5>
                    <h3>@Model.TotalExpense.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white @(Model.Balance >= 0 ? "bg-info" : "bg-warning") mb-3">
                <div class="card-body">
                    <h5 class="card-title">Баланс за период</h5>
                    <h3>@Model.Balance.ToString("C")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Форма фильтрации -->
    <form method="get" asp-action="Index" class="row g-3 mb-4 p-3 bg-light rounded">
        <div class="col-md-3">
            <label class="form-label">С даты:</label>
            <input type="date" name="startDate" class="form-control"
                   value="@Model.StartDate.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-3">
            <label class="form-label">По дату:</label>
            <input type="date" name="endDate" class="form-control"
                   value="@Model.EndDate.ToString("yyyy-MM-dd")">
        </div>
        <div class="col-md-2">
            <label class="form-label">Тип:</label>
            <select name="typeFilter" class="form-select">
                <option value="">Все операции</option>
                <option value="Income" selected="@(Model.TypeFilter == "Income")">Доходы</option>
                <option value="Expense" selected="@(Model.TypeFilter == "Expense")">Расходы</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">На странице:</label>
            <select name="pageSize" class="form-select">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="20" selected="@(Model.PageSize == 20)">20</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
                <option value="100" selected="@(Model.PageSize == 100)">100</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-outline-primary w-100">Применить</button>
        </div>
    </form>

    <!-- Таблица операций -->
    <div class="table-responsive">
        <table class="table table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Дата</th>
                    <th>Тип</th>
                    <th>Категория</th>
                    <th>Описание</th>
                    <th class="text-end">Сумма</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Transactions.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Записей за выбранный период не найдено</td>
                    </tr>
                }
                @foreach (var item in Model.Transactions)
                {
                    <tr>
                        <td>@item.Date.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @(item.Type == FinanceTracker.Models.TransactionType.Income ? "bg-success" : "bg-danger")">
                                @(item.Type == FinanceTracker.Models.TransactionType.Income ? "Доход" : "Расход")
                            </span>
                        </td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Description</td>
                        <td class="text-end fw-bold @(item.Type == FinanceTracker.Models.TransactionType.Income ? "text-success" : "text-danger")">
                            @(item.Type == FinanceTracker.Models.TransactionType.Income ? "+" : "-")@item.Amount.ToString("C")
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Удалить эту запись?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Пагинация -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Навигация по страницам">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       asp-route-typeFilter="@Model.TypeFilter"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page - 1)">← Назад</a>
                </li>

                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.Page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                           asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                           asp-route-typeFilter="@Model.TypeFilter"
                           asp-route-pageSize="@Model.PageSize"
                           asp-route-page="@i">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-startDate="@Model.StartDate.ToString("yyyy-MM-dd")"
                       asp-route-endDate="@Model.EndDate.ToString("yyyy-MM-dd")"
                       asp-route-typeFilter="@Model.TypeFilter"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-page="@(Model.Page + 1)">Вперёд →</a>
                </li>
            </ul>
        </nav>

        <p class="text-center text-muted">
            Всего записей: @Model.TotalCount (страница @Model.Page из @Model.TotalPages)
        </p>
    }
</div>
